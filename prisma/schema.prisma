// ============================================================
// Schéma Prisma — Base de données Bull ASUR
// ============================================================
//
// Ce fichier définit le modèle de données complet de l'application :
// - Utilisateurs avec héritage polymorphique (Admin, Secrétariat, Enseignant, Étudiant)
// - Référentiel académique (Semestres → UE → Matières)
// - Classes / Promotions scolaires
// - Évaluations (CC, Examen, Rattrapage) et Absences
// - Résultats calculés (MoyenneMatière, MoyenneUE, ResultatSemestre, ResultatAnnuel)
// - Annonces
// - Configuration système paramétrable
//
// Documentation Prisma : https://pris.ly/d/prisma-schema

// ──────────────────────────────────────────────────────────
// CONFIGURATION DU GÉNÉRATEUR ET DE LA SOURCE DE DONNÉES
// ──────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // directUrl est activé pour les migrations Prisma (décommenter si le port 5432 est accessible)
  // directUrl  = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────
// ENUMS — Types énumérés partagés
// ──────────────────────────────────────────────────────────

// Rôles utilisateur
enum Role {
  ADMINISTRATEUR
  SECRETARIAT
  ENSEIGNANT
  ETUDIANT
}

// Statut d'un étudiant dans son cursus
enum StatutEtudiant {
  INSCRIT      // Inscrit en cours d'année (par défaut)
  REDOUBLANT   // Redouble l'année en cours
  DIPLOME      // A obtenu son diplôme
  ABANDONNE    // A abandonné le cursus
}

// ──────────────────────────────────────────────────────────
// FILIERES — Groupement de classes par domaine d'étude
// ──────────────────────────────────────────────────────────

model Filiere {
  id          String   @id @default(cuid())
  nom         String   @unique
  code        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes     Classe[]

  @@map("filieres")
}

// ──────────────────────────────────────────────────────────
// CLASSES — Promotions scolaires
// ──────────────────────────────────────────────────────────
//
// Une classe regroupe des étudiants pour une année universitaire.
// Exemples : "LP ASUR 2025-2026", "GI 1A 2025-2026"
//
// Relation avec Semestre : many-to-many via SemestreClasse
// (Ex: GI 1A et GI 1B partagent le même S1)

model Classe {
  id                 String   @id @default(cuid())
  nom                String                        // Ex: "LP ASUR 2025"
  code               String   @unique              // Ex: "ASUR-2025" — identifiant unique
  anneeUniversitaire String                        // Ex: "2025-2026"
  capaciteMax        Int?                          // Capacité maximale (optionnel)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  filiereId          String?
  filiere            Filiere?                      @relation(fields: [filiereId], references: [id], onDelete: SetNull)
  etudiants          Etudiant[]                    // Étudiants inscrits dans cette classe
  semestres          SemestreClasse[]              // Semestres assignés à cette classe (N:M)

  @@map("classes")
}

// Table de liaison Semestre ↔ Classe (many-to-many)
// Un semestre peut appartenir à plusieurs classes (GI 1A et GI 1B partagent S1)
// Une classe peut avoir plusieurs semestres (S5 et S6)
model SemestreClasse {
  semestreId String
  classeId   String

  semestre   Semestre @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  classe     Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)

  @@id([semestreId, classeId])
  @@map("semestre_classes")
}

// ──────────────────────────────────────────────────────────
// UTILISATEURS — Héritage polymorphique (Table-per-Type)
// ──────────────────────────────────────────────────────────

model Utilisateur {
  id        String   @id @default(cuid())
  nom       String   @unique
  password  String   @unique
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations polymorphiques 1:1
  admin       Admin?
  secretariat Secretariat?
  enseignant  Enseignant?
  etudiant    Etudiant?

  // Relations métier
  evaluations        Evaluation[]
  absences           Absence[]
  moyenneMatieres    MoyenneMatiere[]
  moyenneUEs         MoyenneUE[]
  resultatSemestres  ResultatSemestre[]
  resultatAnnuel     ResultatAnnuel?
  matieresEnseignees MatiereEnseignant[]

  @@map("utilisateurs")
}

// ──────────────────────────────────────────────────────────
// TABLES FILLES — Profils spécifiques par rôle
// ──────────────────────────────────────────────────────────

model Admin {
  utilisateurId String      @id
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Secretariat {
  utilisateurId String      @id
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("secretariats")
}

// Profil étudiant — informations personnelles et scolaires
model Etudiant {
  utilisateurId  String         @id
  utilisateur    Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  prenom         String                         // Prénom de l'étudiant
  matricule      String         @unique          // Numéro matricule unique
  date_naissance DateTime                        // Date de naissance
  lieu_naissance String                          // Lieu de naissance
  bac_type       String                          // Type de baccalauréat obtenu
  annee_bac      Int                             // Année d'obtention du bac
  provenance     String                          // Établissement d'origine
  statut         StatutEtudiant @default(INSCRIT) // Statut dans le cursus

  // Lien vers la classe (optionnel pour permettre les migrations sans casser les données)
  classeId       String?
  classe         Classe?        @relation(fields: [classeId], references: [id], onDelete: SetNull)

  @@map("etudiants")
}

// Profil enseignant
model Enseignant {
  utilisateurId String      @id
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  prenom        String
  matricule     String      @unique
  specialite    String?

  @@map("enseignants")
}

// ──────────────────────────────────────────────────────────
// RÉFÉRENTIEL ACADÉMIQUE — Structure hiérarchique
// ──────────────────────────────────────────────────────────
// Hiérarchie : Semestre → Unité d'Enseignement (UE) → Matière

model Semestre {
  id                 String   @id @default(cuid())
  code               String   @unique
  libelle            String
  anneeUniversitaire String

  // Relations
  ues               UniteEnseignement[]
  resultatSemestres ResultatSemestre[]
  classes           SemestreClasse[]   // Classes qui suivent ce semestre (N:M)

  @@map("semestres")
}

model UniteEnseignement {
  id         String   @id @default(cuid())
  code       String   @unique
  libelle    String
  semestreId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  semestre   Semestre  @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  matieres   Matiere[]
  moyenneUEs MoyenneUE[]

  @@map("unites_enseignement")
}

model Matiere {
  id                  String   @id @default(cuid())
  libelle             String
  coefficient         Float
  credits             Int
  uniteEnseignementId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  uniteEnseignement UniteEnseignement @relation(fields: [uniteEnseignementId], references: [id], onDelete: Cascade)
  evaluations       Evaluation[]
  absences          Absence[]
  moyenneMatieres   MoyenneMatiere[]
  enseignants       MatiereEnseignant[]

  @@map("matieres")
}

// ──────────────────────────────────────────────────────────
// ÉVALUATIONS — Saisie des notes
// ──────────────────────────────────────────────────────────

model Evaluation {
  id            String         @id @default(cuid())
  utilisateurId String
  matiereId     String
  type          TypeEvaluation
  note          Float?
  dateSaisie    DateTime       @default(now())
  saisiePar     String

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, matiereId, type])
  @@map("evaluations")
}

enum TypeEvaluation {
  CC
  EXAMEN
  RATTRAPAGE
}

// ──────────────────────────────────────────────────────────
// ABSENCES — Suivi des heures d'absence par matière
// ──────────────────────────────────────────────────────────

model Absence {
  id            String   @id @default(cuid())
  utilisateurId String
  matiereId     String
  heures        Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, matiereId])
  @@map("absences")
}

// ──────────────────────────────────────────────────────────
// RÉSULTATS CALCULÉS — Moyennes et validations
// ──────────────────────────────────────────────────────────

model MoyenneMatiere {
  id                String   @id @default(cuid())
  utilisateurId     String
  matiereId         String
  moyenne           Float
  rattrapageUtilise Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, matiereId])
  @@map("moyenne_matieres")
}

model MoyenneUE {
  id                  String   @id @default(cuid())
  utilisateurId       String
  uniteEnseignementId String
  moyenne             Float
  creditsAcquis       Int
  compense            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  utilisateur       Utilisateur       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  uniteEnseignement UniteEnseignement @relation(fields: [uniteEnseignementId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, uniteEnseignementId])
  @@map("moyenne_ues")
}

model ResultatSemestre {
  id              String   @id @default(cuid())
  utilisateurId   String
  semestreId      String
  moyenneSemestre Float
  creditsTotal    Int
  creditsAcquis   Int      @default(0)
  valide          Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  semestre    Semestre    @relation(fields: [semestreId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, semestreId])
  @@map("resultat_semestres")
}

model ResultatAnnuel {
  id              String        @id @default(cuid())
  utilisateurId   String        @unique
  annee           String
  moyenneAnnuelle Float?
  decisionJury    DecisionJury?
  mention         Mention?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("resultat_annuels")
}

// ──────────────────────────────────────────────────────────
// ENUMS — Décisions et mentions
// ──────────────────────────────────────────────────────────

enum DecisionJury {
  DIPLOME            // 60 crédits acquis — diplôme obtenu
  REPRISE_SOUTENANCE // Tous crédits sauf UE6-2 (soutenance)
  REDOUBLE           // Crédits insuffisants — redouble la L3 (corrigé : REDOUBLANCE → REDOUBLE)
  ADMISSIBLE_S6      // En attente de soutenance S6
}

enum Mention {
  PASSABLE    // 10 ≤ moyenne < 12
  ASSEZ_BIEN  // 12 ≤ moyenne < 14
  BIEN        // 14 ≤ moyenne < 16
  TRES_BIEN   // moyenne ≥ 16
}

// ──────────────────────────────────────────────────────────
// TABLE DE LIAISON — Enseignants ↔ Matières
// ──────────────────────────────────────────────────────────

model MatiereEnseignant {
  id            String   @id @default(cuid())
  utilisateurId String
  matiereId     String
  createdAt     DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, matiereId])
  @@map("matiere_enseignant")
}

// ──────────────────────────────────────────────────────────
// ANNONCES — Tableau d'affichage
// ──────────────────────────────────────────────────────────
//
// Permet d'afficher des messages ciblés sur les tableaux de bord.
// cible = null → visible par tous les rôles.
// cible = ETUDIANT → uniquement visible par les étudiants, etc.

model Annonce {
  id        String   @id @default(cuid())
  titre     String
  contenu   String
  cible     Role?    // Null = visible par tous, sinon ciblé par rôle
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("annonces")
}

// ──────────────────────────────────────────────────────────
// CONFIGURATION SYSTÈME — Paramètres clé-valeur
// ──────────────────────────────────────────────────────────

model Configuration {
  id        String   @id @default(cuid())
  cle       String   @unique
  valeur    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configurations")
}
