// ============================================================
// Schéma Prisma — Base de données Bull ASUR
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────

enum Role {
  ADMINISTRATEUR
  SECRETARIAT
  ENSEIGNANT
  ETUDIANT
}

enum StatutEtudiant {
  INSCRIT
  REDOUBLANT
  DIPLOME
  ABANDONNE
}

enum TypeEvaluation {
  CC
  EXAMEN
  RATTRAPAGE
}

enum DecisionJury {
  DIPLOME
  REPRISE_SOUTENANCE
  REDOUBLE
  ADMISSIBLE_S6
}

enum Mention {
  PASSABLE
  ASSEZ_BIEN
  BIEN
  TRES_BIEN
}

// ──────────────────────────────────────────────────────────
// FILIERES
// ──────────────────────────────────────────────────────────

model Filiere {
  id        String   @id @default(cuid())
  nom       String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Classe[]

  @@map("filieres")
}

// ──────────────────────────────────────────────────────────
// CLASSES
// ──────────────────────────────────────────────────────────

model Classe {
  id                 String   @id @default(cuid())
  nom                String
  code               String   @unique
  anneeUniversitaire String
  capaciteMax        Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  filiereId String?
  filiere   Filiere? @relation(fields: [filiereId], references: [id], onDelete: SetNull)

  etudiants Etudiant[]
  semestres SemestreClasse[]

  @@map("classes")
}

model SemestreClasse {
  semestreId String
  classeId   String

  semestre Semestre @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  classe   Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)

  @@id([semestreId, classeId])
  @@map("semestre_classes")
}

// ──────────────────────────────────────────────────────────
// UTILISATEURS
// ──────────────────────────────────────────────────────────

model Utilisateur {
  id        String   @id @default(cuid())
  nom       String   @unique
  password  String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin       Admin?
  secretariat Secretariat?
  enseignant  Enseignant?
  etudiant    Etudiant?

  evaluations        Evaluation[]
  absences           Absence[]
  moyenneMatieres    MoyenneMatiere[]
  moyenneUEs         MoyenneUE[]
  resultatSemestres  ResultatSemestre[]
  resultatAnnuel     ResultatAnnuel?
  matieresEnseignees MatiereEnseignant[]
  archivesBulletins  ArchiveBulletin[]

  @@map("utilisateurs")
}

// ──────────────────────────────────────────────────────────
// PROFILS PAR RÔLE
// ──────────────────────────────────────────────────────────

model Admin {
  utilisateurId String      @id
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Secretariat {
  utilisateurId String      @id
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("secretariats")
}

model Etudiant {
  utilisateurId  String         @id
  utilisateur    Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  prenom         String
  matricule      String         @unique
  date_naissance DateTime
  lieu_naissance String
  bac_type       String
  annee_bac      Int
  provenance     String
  statut         StatutEtudiant @default(INSCRIT)

  classeId String?
  classe   Classe? @relation(fields: [classeId], references: [id], onDelete: SetNull)

  @@map("etudiants")
}

model Enseignant {
  utilisateurId String      @id
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  prenom        String
  matricule     String      @unique
  specialite    String?

  @@map("enseignants")
}

// ──────────────────────────────────────────────────────────
// RÉFÉRENTIEL ACADÉMIQUE
// ──────────────────────────────────────────────────────────

model Semestre {
  id                 String @id @default(cuid())
  code               String @unique
  libelle            String
  anneeUniversitaire String

  ues               UniteEnseignement[]
  resultatSemestres ResultatSemestre[]
  classes           SemestreClasse[]
  archivesBulletins ArchiveBulletin[]

  @@map("semestres")
}

model UniteEnseignement {
  id          String   @id @default(cuid())
  code        String   @unique
  libelle     String
  semestreId  String
  credits     Int?
  coefficient Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  semestre   Semestre    @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  matieres   Matiere[]
  moyenneUEs MoyenneUE[]

  @@map("unites_enseignement")
}

model Matiere {
  id                  String   @id @default(cuid())
  libelle             String
  coefficient         Float
  credits             Int
  uniteEnseignementId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  uniteEnseignement UniteEnseignement @relation(fields: [uniteEnseignementId], references: [id], onDelete: Cascade)
  evaluations       Evaluation[]
  absences          Absence[]
  moyenneMatieres   MoyenneMatiere[]
  enseignants       MatiereEnseignant[]

  @@map("matieres")
}

// ──────────────────────────────────────────────────────────
// ÉVALUATIONS
// ──────────────────────────────────────────────────────────

model Evaluation {
  id            String         @id @default(cuid())
  utilisateurId String
  matiereId     String
  type          TypeEvaluation
  note          Float?
  dateSaisie    DateTime       @default(now())
  saisiePar     String

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, matiereId, type])
  @@map("evaluations")
}

// ──────────────────────────────────────────────────────────
// ABSENCES
// ──────────────────────────────────────────────────────────

model Absence {
  id            String   @id @default(cuid())
  utilisateurId String
  matiereId     String
  heures        Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, matiereId])
  @@map("absences")
}

// ──────────────────────────────────────────────────────────
// RÉSULTATS CALCULÉS
// ──────────────────────────────────────────────────────────

model MoyenneMatiere {
  id                String   @id @default(cuid())
  utilisateurId     String
  matiereId         String
  moyenne           Float
  rang              Int?
  appreciation      String?
  rattrapageUtilise Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, matiereId])
  @@map("moyenne_matieres")
}

model MoyenneUE {
  id                  String   @id @default(cuid())
  utilisateurId       String
  uniteEnseignementId String
  moyenne             Float
  rang                Int?
  appreciation        String?
  creditsAcquis       Int
  compense            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  utilisateur       Utilisateur       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  uniteEnseignement UniteEnseignement @relation(fields: [uniteEnseignementId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, uniteEnseignementId])
  @@map("moyenne_ues")
}

model ResultatSemestre {
  id              String   @id @default(cuid())
  utilisateurId   String
  semestreId      String
  moyenneSemestre Float
  rang            Int
  appreciation    String
  creditsTotal    Int
  creditsAcquis   Int      @default(0)
  valide          Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  semestre    Semestre    @relation(fields: [semestreId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, semestreId])
  @@map("resultat_semestres")
}

model ResultatAnnuel {
  id              String        @id @default(cuid())
  utilisateurId   String        @unique
  annee           String
  moyenneAnnuelle Float
  rang            Int
  decisionJury    DecisionJury
  mention         Mention
  appreciation    String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("resultat_annuels")
}

// ──────────────────────────────────────────────────────────
// TABLE DE LIAISON — Enseignants ↔ Matières
// ──────────────────────────────────────────────────────────

model MatiereEnseignant {
  id            String   @id @default(cuid())
  utilisateurId String
  matiereId     String
  createdAt     DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, matiereId])
  @@map("matiere_enseignant")
}

// ──────────────────────────────────────────────────────────
// ANNONCES
// ──────────────────────────────────────────────────────────

model Annonce {
  id        String   @id @default(cuid())
  titre     String
  contenu   String
  cible     Role?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("annonces")
}

// ──────────────────────────────────────────────────────────
// CONFIGURATION SYSTÈME
// ──────────────────────────────────────────────────────────

model Configuration {
  id        String   @id @default(cuid())
  cle       String   @unique
  valeur    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configurations")
}

// ──────────────────────────────────────────────────────────
// ARCHIVE DES BULLETINS
// ──────────────────────────────────────────────────────────

model ArchiveBulletin {
  id              String   @id @default(cuid())
  utilisateurId   String
  semestreId      String?
  type            String   // "semestre" ou "annuel"
  donneesJson     Json     // Contient la snapshot des données du bulletin généré
  dateGeneration  DateTime @default(now())

  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  semestre        Semestre?   @relation(fields: [semestreId], references: [id], onDelete: SetNull)

  @@map("archive_bulletins")
}

// ──────────────────────────────────────────────────────────
// JOURNAL D'AUDIT
// ──────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // "CREATE", "UPDATE", "DELETE", "LOGIN", "EXPORT", etc.
  entity      String   // "Etudiant", "Enseignant", "Note", "Bulletin", etc.
  entityId    String?
  details     Json?    // Détails supplémentaires (ex: anciennes/nouvelles valeurs)
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

